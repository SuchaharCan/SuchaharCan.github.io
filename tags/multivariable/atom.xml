        <title>高等数学 · 多元微积分（偏导 &#x2F; 重积分 &#x2F; 线面积分）</title>
        <published>2026-08-11T00:00:00+00:00</published>
        <updated>2026-08-11T00:00:00+00:00</updated>
        
        <author>
          <name>
            
              Suchaharcan
            
          </name>
        </author>
        
        <link rel="alternate" type="text/html" href="https://suchaharcan.github.io/00Read_blog_Math/math-calculus-multi/"/>
