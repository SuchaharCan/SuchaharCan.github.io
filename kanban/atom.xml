&lt;li&gt;&lt;input disabled=&quot;&quot; type=&quot;checkbox&quot; checked=&quot;&quot;/&gt;
Trello 明细页与列表进度条&lt;/li&gt;
&lt;/ul&gt;
</content>
        
    </entry>
    <entry xml:lang="en">
        <title>看板 Markdown 映射说明</title>
        <published>2026-06-21T00:00:00+00:00</published>
        <updated>2026-06-21T00:00:00+00:00</updated>
        
        <author>
          <name>Suchaharcan</name>
        </author>
        
        <link rel="alternate" type="text/html" href="https://suchaharcan.github.io/kanban/kanban-mapping/"/>
        <id>https://suchaharcan.github.io/kanban/kanban-mapping/</id>
        
        <content type="html" xml:base="https://suchaharcan.github.io/kanban/kanban-mapping/">&lt;h1 id=&quot;zhou-ji-hua-kan-ban-markdown-ying-she-shuo-ming&quot;&gt;周计划看板 · Markdown 映射说明&lt;/h1&gt;
&lt;p&gt;看板数据统一存放在 &lt;strong&gt;&lt;code&gt;content/kanban/&lt;/code&gt;&lt;/strong&gt;（&lt;strong&gt;一个 &lt;code&gt;.md&lt;/code&gt; 文件 = 一个自然周，或单日「上午 / 下午 / 晚上」时段看板&lt;/strong&gt;）。&lt;br /&gt;
Zola 构建时将原始 Markdown 内嵌到页面，规则引擎直接解析，无需 &lt;code&gt;static/&lt;/code&gt; 副本。&lt;/p&gt;
&lt;h2 id=&quot;wen-jian-ming-ming&quot;&gt;文件命名&lt;/h2&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;规则&lt;/th&gt;&lt;th&gt;示例&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;默认以 &lt;code&gt;week_start&lt;/code&gt; 日期命名&lt;/td&gt;&lt;td&gt;&lt;code&gt;2026-06-16.md&lt;/code&gt;（对应 6.16 – 6.22）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;strong&gt;单日 + 时段&lt;/strong&gt;：&lt;code&gt;week_start_时段&lt;/code&gt;，保证同一天多张 1 天看板文件名唯一&lt;/td&gt;&lt;td&gt;&lt;code&gt;2026-08-11_上午.md&lt;/code&gt; / &lt;code&gt;2026-08-11_下午.md&lt;/code&gt; / &lt;code&gt;2026-08-11_晚上.md&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;路径&lt;/td&gt;&lt;td&gt;&lt;code&gt;content/kanban/2026-06-16.md&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h2 id=&quot;front-matter-ye-mian-yuan-shu-ju&quot;&gt;Front Matter（页面元数据）&lt;/h2&gt;
&lt;pre class=&quot;giallo z-l-code z-d-code&quot; &gt;&lt;code data-lang=&quot;toml&quot;&gt;&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-9 z-l-i z-l-u z-d-9 z-d-i z-d-u&quot;&gt;+++&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;title&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; &amp;quot;&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;6.16 – 6.22 周计划&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;&amp;quot;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;description&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; &amp;quot;&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;列表页摘要，可选&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;&amp;quot;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;date&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span&gt; 2026-06-16&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;template&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; &amp;quot;&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;kanban.html&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;&amp;quot;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;[&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;extra&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;]&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;week_start&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; &amp;quot;&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;2026-06-16&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;&amp;quot;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;week_end&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; &amp;quot;&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;2026-06-22&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;&amp;quot;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;core_tasks&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; &amp;quot;&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt;本周核心任务一句话&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;&amp;quot;&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;stats&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; {&lt;/span&gt;&lt;span&gt; total&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-3 z-d-6&quot;&gt; 8&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;,&lt;/span&gt;&lt;span&gt; done&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-3 z-d-6&quot;&gt; 3&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;,&lt;/span&gt;&lt;span&gt; todo&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-3 z-d-6&quot;&gt; 3&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;,&lt;/span&gt;&lt;span&gt; doing&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; =&lt;/span&gt;&lt;span class=&quot;z-l-3 z-d-6&quot;&gt; 2&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; }&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-9 z-l-i z-l-u z-d-9 z-d-i z-d-u&quot;&gt;+++&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;字段&lt;/th&gt;&lt;th&gt;说明&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;week_start&lt;/code&gt; / &lt;code&gt;week_end&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;顶格时间约束&lt;/strong&gt;：必须优先设置；跨度 &lt;strong&gt;1 ~ 14 天&lt;/strong&gt;（默认新建 = 今日到今日）；修改已有看板时 &lt;code&gt;week_start&lt;/code&gt; &lt;strong&gt;锁定不可编辑&lt;/strong&gt;，&lt;code&gt;week_end&lt;/code&gt; 最大为开始 +13 天；全部卡片的 &lt;code&gt;@start&lt;/code&gt; / &lt;code&gt;@due&lt;/code&gt; 必须落在该区间内（GUI 编辑器校验并限制日期选择）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;period&lt;/code&gt;&lt;/td&gt;&lt;td&gt;时段：&lt;code&gt;上午&lt;/code&gt; / &lt;code&gt;下午&lt;/code&gt; / &lt;code&gt;晚上&lt;/code&gt;（仅单天看板参与文件名，保证同日多看板唯一）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;core_tasks&lt;/code&gt;&lt;/td&gt;&lt;td&gt;列表卡片展示的核心任务&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;board_bg&lt;/code&gt;&lt;/td&gt;&lt;td&gt;看板背景（预置色名或 &lt;code&gt;#RRGGBB&lt;/code&gt; / &lt;code&gt;gradient(...)&lt;/code&gt;，Trello 风格）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;favorite&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;true&lt;/code&gt; / &lt;code&gt;false&lt;/code&gt;，看板标题旁星标收藏（需保存生效）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;stats&lt;/code&gt;&lt;/td&gt;&lt;td&gt;进度统计（按列名自动计算）&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;jie-gou-ying-she&quot;&gt;结构映射&lt;/h2&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Markdown&lt;/th&gt;&lt;th&gt;看板元素&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;# 列表名&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;一列&lt;/strong&gt;（待办 / 进行中 / 已完成 / 资源 / 目标）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;## 卡片标题&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;一张卡片&lt;/strong&gt;，归属上方最近的 &lt;code&gt;#&lt;/code&gt; 列表&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;p&gt;列顺序 = 文件中 &lt;code&gt;#&lt;/code&gt; 出现顺序。&lt;br /&gt;
卡片顺序 = 各列内 &lt;code&gt;##&lt;/code&gt; 出现顺序。&lt;/p&gt;
&lt;p&gt;列表级可选指令（写在 &lt;code&gt;# 列名&lt;/code&gt; 之后、第一张卡片之前）：&lt;/p&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;指令&lt;/th&gt;&lt;th&gt;语法&lt;/th&gt;&lt;th&gt;看板表现&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;列内排序&lt;/td&gt;&lt;td&gt;&lt;code&gt;@sort manual / due / priority / title / checklist&lt;/code&gt;&lt;/td&gt;&lt;td&gt;明细页按该规则排序显示（默认 manual）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;排序方向&lt;/td&gt;&lt;td&gt;&lt;code&gt;@sort-order asc / desc&lt;/code&gt;&lt;/td&gt;&lt;td&gt;升序（默认）/ 降序&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;qia-pian-shu-xing-gui-ze-yin-qing-zhi-ling&quot;&gt;卡片属性 · 规则引擎指令&lt;/h2&gt;
&lt;p&gt;指令单独占一行，写在 &lt;code&gt;## 标题&lt;/code&gt; 之后、正文之前。以 &lt;code&gt;@&lt;/code&gt; 开头，&lt;strong&gt;大小写不敏感&lt;/strong&gt;。&lt;/p&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;指令&lt;/th&gt;&lt;th&gt;语法&lt;/th&gt;&lt;th&gt;看板表现&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;截止日期&lt;/td&gt;&lt;td&gt;&lt;code&gt;@due 2026-06-20&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片底部截止图标 + 日期&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;开始日期&lt;/td&gt;&lt;td&gt;&lt;code&gt;@start 2026-06-16&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片底部开始图标 + 日期&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;重要等级&lt;/td&gt;&lt;td&gt;&lt;code&gt;@priority 4&lt;/code&gt; 或 &lt;code&gt;@importance 4&lt;/code&gt;&lt;/td&gt;&lt;td&gt;1–5 星（淡黄色，满星填充）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;目标类型&lt;/td&gt;&lt;td&gt;&lt;code&gt;@goal complete&lt;/code&gt; / &lt;code&gt;@goal risk&lt;/code&gt;&lt;/td&gt;&lt;td&gt;目标看板：完成效果（淡蓝）/ 未完成后果（灰爆）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;颜色标签&lt;/td&gt;&lt;td&gt;&lt;code&gt;@labels red, blue&lt;/code&gt; 或 &lt;code&gt;@label green&lt;/code&gt;&lt;/td&gt;&lt;td&gt;明细页顶栏色条（权重 n）；列表页不显示&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;顶栏色&lt;/td&gt;&lt;td&gt;&lt;code&gt;@top red&lt;/code&gt; 或 &lt;code&gt;@top orange&lt;/code&gt;&lt;/td&gt;&lt;td&gt;明细页卡片顶部粗色条（Trello 顶栏）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;封面尺寸&lt;/td&gt;&lt;td&gt;&lt;code&gt;@cover half&lt;/code&gt; / &lt;code&gt;@cover full&lt;/code&gt;&lt;/td&gt;&lt;td&gt;半封面（默认）= 顶部色条；&lt;strong&gt;全封面 = 整卡背景着色&lt;/strong&gt;（浅色自动深字）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;完成状态&lt;/td&gt;&lt;td&gt;&lt;code&gt;@done&lt;/code&gt; 或 &lt;code&gt;@complete&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片正面打勾、标题划线、截止徽标变绿（Trello “标记完成”）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;置顶&lt;/td&gt;&lt;td&gt;&lt;code&gt;@pin&lt;/code&gt; 或 &lt;code&gt;@置顶&lt;/code&gt;&lt;/td&gt;&lt;td&gt;同一列表可多卡片置顶；置顶卡片优先显示，卡片带 📌 徽标&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;背景封面色&lt;/td&gt;&lt;td&gt;&lt;code&gt;@bg orange&lt;/code&gt; 或 &lt;code&gt;@bg #FFE0B2&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片封面：半封面 = 顶部色条；配合 &lt;code&gt;@cover full&lt;/code&gt; = 整卡背景着色&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;顶栏色&lt;/td&gt;&lt;td&gt;&lt;code&gt;@top red&lt;/code&gt; 或 &lt;code&gt;@top #E53935&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片顶部细色条（Trello 顶栏）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;勾选框&lt;/td&gt;&lt;td&gt;&lt;code&gt;- [ ] 未完成&lt;/code&gt; / &lt;code&gt;- [x] 已完成&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片内 checklist&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h3 id=&quot;yu-zhi-biao-qian-se-ming&quot;&gt;预置标签色名&lt;/h3&gt;
&lt;p&gt;&lt;code&gt;red&lt;/code&gt; · &lt;code&gt;orange&lt;/code&gt; · &lt;code&gt;yellow&lt;/code&gt; · &lt;code&gt;green&lt;/code&gt; · &lt;code&gt;blue&lt;/code&gt; · &lt;code&gt;purple&lt;/code&gt; · &lt;code&gt;pink&lt;/code&gt; · &lt;code&gt;sky&lt;/code&gt; · &lt;code&gt;lime&lt;/code&gt; · &lt;code&gt;black&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;也支持 &lt;code&gt;#RGB&lt;/code&gt; / &lt;code&gt;#RRGGBB&lt;/code&gt; 十六进制。&lt;/p&gt;
&lt;h3 id=&quot;miao-shu-zheng-wen&quot;&gt;描述正文&lt;/h3&gt;
&lt;p&gt;除 &lt;code&gt;@&lt;/code&gt; 指令与 checkbox 行以外的 Markdown（段落、列表、加粗等）→ 卡片&lt;strong&gt;描述区&lt;/strong&gt;。&lt;/p&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;wan-zheng-shi-li&quot;&gt;完整示例&lt;/h2&gt;
&lt;pre class=&quot;giallo z-l-code z-d-code&quot; &gt;&lt;code data-lang=&quot;markdown&quot;&gt;&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;#&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt; 待办&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;##&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt; 规则引擎文档&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@due 2026-06-18&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@labels blue, green&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@top purple&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;-&lt;/span&gt;&lt;span&gt; [ ] 编写 kanban-rules.js&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;-&lt;/span&gt;&lt;span&gt; [ ] 补充映射说明&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;完成 &lt;/span&gt;&lt;span class=&quot;z-l-5 z-l-b z-d-4 z-d-b&quot;&gt;**&lt;/span&gt;&lt;span class=&quot; z-l-b z-d-b&quot;&gt;Markdown ↔ 看板&lt;/span&gt;&lt;span class=&quot;z-l-5 z-l-b z-d-4 z-d-b&quot;&gt;**&lt;/span&gt;&lt;span&gt; 双向转换说明。&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;#&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt; 进行中&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;##&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt; 看板 UI&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@bg #FFF3E0&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@top orange&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@due 2026-06-20&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; [&lt;/span&gt;&lt;span class=&quot;z-l-9 z-d-9&quot;&gt;x&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;]&lt;/span&gt;&lt;span&gt; Trello 列布局&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;-&lt;/span&gt;&lt;span&gt; [ ] 拖拽交互&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;#&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt; 已完成&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;##&lt;/span&gt;&lt;span class=&quot;z-l-8 z-d-10&quot;&gt; 需求梳理&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;@labels green&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt; [&lt;/span&gt;&lt;span class=&quot;z-l-9 z-d-9&quot;&gt;x&lt;/span&gt;&lt;span class=&quot;z-l-5 z-d-4&quot;&gt;]&lt;/span&gt;&lt;span&gt; 对齐 article / nanolog 结构&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;bian-ji-fang-shi&quot;&gt;编辑方式&lt;/h2&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;状态&lt;/th&gt;&lt;th&gt;行为&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;strong&gt;锁定&lt;/strong&gt;（默认）&lt;/td&gt;&lt;td&gt;不可拖拽；隐藏 ReDeplog / Edit Post / 映射说明&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;strong&gt;解锁&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;仅在 &lt;code&gt;week_start&lt;/code&gt;～&lt;code&gt;week_end&lt;/code&gt; 窗口内可切换；可拖拽卡片跨列（本地预览）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;strong&gt;保存&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;点击 &lt;strong&gt;Edit Post&lt;/strong&gt;：先将当前看板按映射规则序列化写入 &lt;code&gt;content/kanban/_edit-buffer.md&lt;/code&gt;（缓冲），再覆盖 &lt;code&gt;content/kanban/&amp;lt;周&amp;gt;.md&lt;/code&gt;；无 Token 时复制到剪贴板并在 Codeberg 编辑器粘贴&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;strong&gt;超期&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;截止日 &lt;code&gt;week_end&lt;/code&gt; 当日 &lt;strong&gt;23:00&lt;/strong&gt;（站点 &lt;code&gt;zola.toml&lt;/code&gt; → &lt;code&gt;extra.timezone&lt;/code&gt;）之后永久只读，无法解锁&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;kan-ban-xiang-qing-ye-trello-dui-qi&quot;&gt;看板详情页（Trello 对齐）&lt;/h2&gt;
&lt;p&gt;明细页 UI 全盘参考 Trello 重构：&lt;/p&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;区域&lt;/th&gt;&lt;th&gt;行为&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;看板头部&lt;/td&gt;&lt;td&gt;返回链接 · 标题 · &lt;strong&gt;收藏星标&lt;/strong&gt;（&lt;code&gt;extra.favorite&lt;/code&gt;）· 开始/截止/剩余天数/进度/星级 元信息行&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;背景&lt;/td&gt;&lt;td&gt;由 &lt;code&gt;extra.board_bg&lt;/code&gt; 控制；菜单 → 背景 可快速切换 12 种预置渐变（需保存生效）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;工具栏&lt;/td&gt;&lt;td&gt;锁定 / &lt;strong&gt;筛选&lt;/strong&gt;（快捷键 &lt;code&gt;F&lt;/code&gt;）/ &lt;strong&gt;菜单&lt;/strong&gt; / GUI 编辑 / Edit Post / ReDeplog / 映射说明&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;筛选&lt;/td&gt;&lt;td&gt;关键词 + 标签 + 截止状态（已逾期/即将到期/无截止）+ 最低优先级 + 隐藏已完成；列计数显示 &lt;code&gt;可见/总数&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;列&lt;/td&gt;&lt;td&gt;头部 = 列名 + 计数 + &lt;code&gt;⋯&lt;/code&gt; 菜单（添加卡片 / 排序 / 重命名 / 删除列）；解锁后可拖拽列头调整顺序&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;卡片正面&lt;/td&gt;&lt;td&gt;标签药丸（带文字）· 封面（&lt;code&gt;@bg&lt;/code&gt; + &lt;code&gt;@cover&lt;/code&gt;）· 完成圆圈（&lt;code&gt;@due&lt;/code&gt; 时显示，切换 &lt;code&gt;@done&lt;/code&gt;）· 置顶 📌 徽标（&lt;code&gt;@pin&lt;/code&gt;）· 徽标行（描述/开始/截止/清单进度/优先级）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;截止徽标&lt;/td&gt;&lt;td&gt;按 Trello 色义：灰色（未到）· 黄（今天/即将到期）· 红（逾期）· 粉（逾期超 1 天）· 绿（已完成）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;菜单抽屉&lt;/td&gt;&lt;td&gt;关于此看板（进度条）· 背景色板 · 搜索卡片（回车进入筛选）· 更多（GUI 编辑 / 保存 / ReDeplog / 映射说明）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;快捷添加&lt;/td&gt;&lt;td&gt;解锁后每列底部「＋ 添加卡片」、看板右侧「＋ 添加列表」，回车即插入（保存走 Edit Post）&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;p&gt;以上所有本地修改都会提示“有未保存的本地修改”，统一通过 &lt;strong&gt;Edit Post&lt;/strong&gt; 序列化保存。&lt;/p&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;gui-bian-ji-qi-xin-jian-xiu-gai-kan-ban&quot;&gt;GUI 编辑器（新建 / 修改看板）&lt;/h2&gt;
&lt;p&gt;除了直接编写 Markdown，看板提供 &lt;strong&gt;GUI 方式&lt;/strong&gt;生成 / 修改：按「看板图标 / 指令的可选值」用&lt;strong&gt;下拉框或手动输入&lt;/strong&gt;设置，自动生成 Markdown。&lt;/p&gt;
&lt;h3 id=&quot;bu-ju-trello-feng-ge-hua-bu-jian-cha-qi&quot;&gt;布局（Trello 风格：画布 + 检查器）&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;左侧画布&lt;/strong&gt;：实时渲染当前看板（背景、列、卡片封面/标签/徽标），点击列或卡片即可选中编辑；底部/右侧可「添加列表」「添加卡片」。&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;右侧检查器&lt;/strong&gt;：根据选中对象切换编辑面板：
&lt;ul&gt;
&lt;li&gt;未选中（看板）：&lt;strong&gt;周起止（顶格时间：先设置；1–14 天；新建默认今日；修改时开始锁定）&lt;/strong&gt; / &lt;strong&gt;时段 period（单天唯一性）&lt;/strong&gt; / 核心任务 / 标题 / 描述 / 星级 / 收藏 / &lt;strong&gt;看板背景色板&lt;/strong&gt;；&lt;/li&gt;
&lt;li&gt;选中列表：列名 / &lt;code&gt;@sort&lt;/code&gt; 排序 / &lt;code&gt;@sort-order&lt;/code&gt; 方向 / 添加卡片 / 上移下移 / 删除列 / 卡片列表；&lt;/li&gt;
&lt;li&gt;选中卡片：标题 / 开始 / 截止（&lt;strong&gt;新建时默认按创建时间=今日填充，可编辑但限制在周起止区间内&lt;/strong&gt;）/ 优先级 / 目标 / &lt;strong&gt;封面&lt;/strong&gt;（&lt;code&gt;@bg&lt;/code&gt; + &lt;code&gt;@cover&lt;/code&gt;）/ 顶栏色 / 标签 / 完成 &lt;code&gt;@done&lt;/code&gt; / &lt;strong&gt;置顶 &lt;code&gt;@pin&lt;/code&gt;&lt;/strong&gt; / 勾选清单 / 描述。&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Markdown 预览&lt;/strong&gt;：底部可折叠，输入时实时更新。&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 id=&quot;ru-kou&quot;&gt;入口&lt;/h3&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;位置&lt;/th&gt;&lt;th&gt;按钮&lt;/th&gt;&lt;th&gt;模式&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;列表页 &lt;code&gt;/kanban/&lt;/code&gt; 页头&lt;/td&gt;&lt;td&gt;&lt;strong&gt;＋ 新建看板&lt;/strong&gt;（管理员可见；Mac-Chrome 浏览器也可见）&lt;/td&gt;&lt;td&gt;新建：默认 &lt;strong&gt;今日 → 今日&lt;/strong&gt;（单天，按当前时间预选 上午/下午/晚上）+ 六列（待办 / 进行中 / 已完成 / 进度 / 资源 / 目标）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;列表页每张周卡片&lt;/td&gt;&lt;td&gt;&lt;strong&gt;✎ 编辑&lt;/strong&gt;（管理员可见）&lt;/td&gt;&lt;td&gt;修改：读取该周已有 Markdown 载入表单&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;明细页工具栏（解锁后）&lt;/td&gt;&lt;td&gt;&lt;strong&gt;GUI 编辑&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;修改：读取当前看板载入表单&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h3 id=&quot;zi-duan-yu-zhi-ling-dui-ying-mei-ge-tu-biao-de-ke-xuan-zhi&quot;&gt;字段与指令对应（每个“图标“的可选值）&lt;/h3&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;表单字段&lt;/th&gt;&lt;th&gt;生成指令&lt;/th&gt;&lt;th&gt;输入方式&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;开始日期&lt;/td&gt;&lt;td&gt;&lt;code&gt;@start YYYY-MM-DD&lt;/code&gt;&lt;/td&gt;&lt;td&gt;日期下拉（默认按创建时间=今日填充，限 [week_start, week_end]）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;截止日期&lt;/td&gt;&lt;td&gt;&lt;code&gt;@due YYYY-MM-DD&lt;/code&gt;&lt;/td&gt;&lt;td&gt;日期下拉（默认按创建时间=今日填充，限 [week_start, week_end]）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;重要等级&lt;/td&gt;&lt;td&gt;&lt;code&gt;@priority 1–5&lt;/code&gt;&lt;/td&gt;&lt;td&gt;下拉（1–5 星 / 无）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;目标类型&lt;/td&gt;&lt;td&gt;&lt;code&gt;@goal complete / risk&lt;/code&gt;&lt;/td&gt;&lt;td&gt;下拉（完成效果 / 未完成后果 / 无）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;颜色标签&lt;/td&gt;&lt;td&gt;&lt;code&gt;@labels red, blue, …&lt;/code&gt;&lt;/td&gt;&lt;td&gt;预设色块多选 + 手输自定义（&lt;code&gt;#RRGGBB&lt;/code&gt; 或颜色名，逗号分隔）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;背景封面色&lt;/td&gt;&lt;td&gt;&lt;code&gt;@bg&lt;/code&gt;&lt;/td&gt;&lt;td&gt;预设色名下拉 + 自定义色值手输 + 实时色块（Trello 封面）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;封面尺寸&lt;/td&gt;&lt;td&gt;&lt;code&gt;@cover&lt;/code&gt;&lt;/td&gt;&lt;td&gt;下拉（默认半封面 / 全封面）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;顶栏色&lt;/td&gt;&lt;td&gt;&lt;code&gt;@top&lt;/code&gt;&lt;/td&gt;&lt;td&gt;预设色名下拉 + 自定义色值手输 + 实时色块&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;完成状态&lt;/td&gt;&lt;td&gt;&lt;code&gt;@done&lt;/code&gt;&lt;/td&gt;&lt;td&gt;复选框&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;置顶&lt;/td&gt;&lt;td&gt;&lt;code&gt;@pin&lt;/code&gt;&lt;/td&gt;&lt;td&gt;卡片面板「置顶 / 解除置顶」按钮；同一列表可多卡片置顶&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;勾选清单&lt;/td&gt;&lt;td&gt;&lt;code&gt;- [ ] / - [x]&lt;/code&gt;&lt;/td&gt;&lt;td&gt;逐行添加：勾选状态 + 文本&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;描述正文&lt;/td&gt;&lt;td&gt;其余 Markdown&lt;/td&gt;&lt;td&gt;多行文本&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;列&lt;/td&gt;&lt;td&gt;&lt;code&gt;# 列名&lt;/code&gt; + &lt;code&gt;@sort&lt;/code&gt; / &lt;code&gt;@sort-order&lt;/code&gt;&lt;/td&gt;&lt;td&gt;画布添加/删除 + 检查器列名/排序&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;周起止 / 核心任务 / 星级&lt;/td&gt;&lt;td&gt;Front Matter&lt;/td&gt;&lt;td&gt;日期 / 文本 / 下拉&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;看板背景 / 收藏&lt;/td&gt;&lt;td&gt;Front Matter&lt;/td&gt;&lt;td&gt;背景色板 / 复选框&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;时段 period&lt;/td&gt;&lt;td&gt;Front Matter（单天命名）&lt;/td&gt;&lt;td&gt;下拉：无 / 上午 / 下午 / 晚上&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h3 id=&quot;mo-ren-xin-jian-bu-ju&quot;&gt;默认新建布局&lt;/h3&gt;
&lt;pre class=&quot;giallo z-l-code z-d-code&quot; &gt;&lt;code data-lang=&quot;plain&quot;&gt;&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;待办    进行中    已完成    进度        ← 主流程列（竖向一排）&lt;/span&gt;&lt;/span&gt;
&lt;span class=&quot;giallo-l&quot;&gt;&lt;span&gt;资源    目标                             ← 底部并排一行&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;进度列&lt;/strong&gt;：从 &lt;code&gt;week_start&lt;/code&gt; 到 &lt;code&gt;week_end&lt;/code&gt; 每一天生成一张卡片（标题如 &lt;code&gt;07-13 周一&lt;/code&gt;），每张默认含一条勾选清单「记录当日完成内容」（可勾选 / 划线）；&lt;/li&gt;
&lt;li&gt;修改顶格时间且进度列仍为自动生成样式（标题匹配 &lt;code&gt;MM-DD 周X&lt;/code&gt;）时，编辑器会自动重排天数；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;置顶&lt;/strong&gt;：置顶卡片始终显示在同列表顶部（多个可同时置顶），卡片正面带 📌 徽标；解锁模式下每张卡片都有「📌 置顶 / 📌 置顶中」切换按钮，点击即置顶/取消置顶；GUI 编辑器卡片面板同样提供按钮。&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 id=&quot;sheng-cheng-jian-tie-ban-chuang-jian-xiu-gai-liu-cheng&quot;&gt;生成 → 剪贴板 → 创建 / 修改流程&lt;/h3&gt;
&lt;ol&gt;
&lt;li&gt;填写表单，右侧 &lt;strong&gt;Markdown 预览&lt;/strong&gt;实时更新（也可点「仅复制 Markdown」）。&lt;/li&gt;
&lt;li&gt;点 &lt;strong&gt;生成并复制到剪贴板&lt;/strong&gt;：
&lt;ul&gt;
&lt;li&gt;自动将序列化后的 Markdown &lt;strong&gt;复制到剪贴板&lt;/strong&gt;；&lt;/li&gt;
&lt;li&gt;弹出操作流程提示，明确区分 &lt;strong&gt;创建&lt;/strong&gt; 还是 &lt;strong&gt;修改&lt;/strong&gt;：
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;创建&lt;/strong&gt;（&lt;code&gt;content/kanban/&amp;lt;周&amp;gt;.md&lt;/code&gt; 不存在）：打开 Codeberg 新建文件 → 粘贴 → 保存提交 → ReDeplog 部署 → 刷新列表；&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;修改&lt;/strong&gt;（文件已存在 / 编辑已有看板）：打开 Codeberg 覆盖文件 → 全选替换 → 保存提交 → ReDeplog 部署 → 刷新列表。&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;若浏览器已保存 &lt;code&gt;kanbanToken&lt;/code&gt;，可点 &lt;strong&gt;用 Token 直接同步到仓库&lt;/strong&gt;（文件不存在走 POST 创建，存在走 PUT 覆盖），再打开 ReDeplog 部署。&lt;/li&gt;
&lt;/ol&gt;
&lt;h3 id=&quot;xiang-guan-wen-jian&quot;&gt;相关文件&lt;/h3&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;文件&lt;/th&gt;&lt;th&gt;作用&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;templates/partials/kanban_editor.html&lt;/code&gt;&lt;/td&gt;&lt;td&gt;编辑器模态框（列表页 / 明细页共用）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;static/js/kanban-editor.js&lt;/code&gt;&lt;/td&gt;&lt;td&gt;表单生成、字段映射、序列化、剪贴板复制、流程提示、Token 同步&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;lie-biao-ye-jin-du-se&quot;&gt;列表页进度色&lt;/h2&gt;
&lt;p&gt;&lt;strong&gt;仅「待办 / 进行中 / 已完成」三列参与进度；「资源 / 目标」不参与。&lt;/strong&gt;&lt;/p&gt;
&lt;h3 id=&quot;bei-jing-se-gui-ze&quot;&gt;背景色规则&lt;/h3&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;条件&lt;/th&gt;&lt;th&gt;卡片背景&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;todo &amp;gt; 3&lt;/code&gt;&lt;/td&gt;&lt;td&gt;全红 &lt;code&gt;#FFEBEE&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;done == total&lt;/code&gt; 且 total &amp;gt; 0&lt;/td&gt;&lt;td&gt;浅绿 &lt;code&gt;#E8F5E9&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;其余&lt;/td&gt;&lt;td&gt;按加权进度百分比渐变（红 → 黄 → 绿）&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h3 id=&quot;jia-quan-jin-du-gong-shi&quot;&gt;加权进度公式&lt;/h3&gt;
&lt;p&gt;以 &lt;strong&gt;50%&lt;/strong&gt; 为基准，逐卡片累加（标签数 &lt;code&gt;n&lt;/code&gt; 为权重，无标签时 &lt;code&gt;n = 1&lt;/code&gt;）：&lt;/p&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;所在列&lt;/th&gt;&lt;th&gt;单项贡献&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;待办&lt;/td&gt;&lt;td&gt;&lt;strong&gt;−10% × n&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;进行中&lt;/td&gt;&lt;td&gt;&lt;strong&gt;+5% × n&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;已完成&lt;/td&gt;&lt;td&gt;&lt;strong&gt;+15% × n&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;p&gt;例：进行中列卡片有 2 个 &lt;code&gt;@labels&lt;/code&gt; → &lt;strong&gt;+5% × 2 = +10%&lt;/strong&gt;。&lt;/p&gt;
&lt;p&gt;结果 clamp 至 0–100%，写入 front matter &lt;code&gt;stats.progress_pct&lt;/code&gt;。&lt;/p&gt;
&lt;p&gt;列表页标题显示 &lt;code&gt;core_tasks&lt;/code&gt;（非日期）；元信息行含开始 / 截止 / 剩余天数 / 星级（&lt;code&gt;importance&lt;/code&gt; 字段，1–5）。&lt;/p&gt;
&lt;hr /&gt;
&lt;h2 id=&quot;xiang-guan-wen-jian-1&quot;&gt;相关文件&lt;/h2&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;文件&lt;/th&gt;&lt;th&gt;作用&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;content/kanban/&lt;/code&gt;&lt;/td&gt;&lt;td&gt;看板 Markdown 唯一维护目录&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;static/js/kanban-rules.js&lt;/code&gt;&lt;/td&gt;&lt;td&gt;解析 / 序列化规则引擎&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;static/js/kanban-board.js&lt;/code&gt;&lt;/td&gt;&lt;td&gt;看板 UI、锁定、拖拽、Edit Post 缓冲写入&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;static/js/kanban-list.js&lt;/code&gt;&lt;/td&gt;&lt;td&gt;列表页剩余天数、动态刷新进度&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;static/js/kanban-editor.js&lt;/code&gt;&lt;/td&gt;&lt;td&gt;GUI 编辑器：表单生成、剪贴板复制、创建 / 修改流程提示&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;templates/partials/kanban_editor.html&lt;/code&gt;&lt;/td&gt;&lt;td&gt;编辑器模态框&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;content/kanban/_edit-buffer.md&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Edit Post 前的 Markdown 缓冲文件&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;templates/kanban.html&lt;/code&gt;&lt;/td&gt;&lt;td&gt;周计划明细（Trello 风格）&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;code&gt;templates/kanban_list.html&lt;/code&gt;&lt;/td&gt;&lt;td&gt;周计划列表&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;p&gt;示例看板：&lt;code&gt;content/kanban/2026-06-16.md&lt;/code&gt;&lt;/p&gt;
</content>
        
    </entry>
